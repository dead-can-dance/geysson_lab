---
interface Props {
  nombre: string;
  conteo: number;
}

const { nombre, conteo } = Astro.props;
const href = `/catalogo?categoria=${encodeURIComponent(nombre)}`;
---

<a
  href={href}
  class="block rounded-xl border border-borde-suave bg-white px-5 py-[22px] text-left transition-colors duration-150 hover:border-morado-principal hover:bg-crema"
>
  <div class="mb-2 font-serif text-[19px] leading-tight text-morado-oscuro">{nombre}</div>
  <div class="font-mono text-[11px] text-lavanda-gris">{conteo} productos</div>
</a>
