---
import { site, linkWhatsApp } from "../data/site";

const waGeneral = linkWhatsApp("Hola, tengo una duda sobre los productos Neurocebryl.");
---

<footer class="bg-morado-oscuro text-[13.5px] text-rosa-grisaceo">
  <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-7 px-7 pt-[52px] pb-[34px]">
    <div class="max-w-[280px]">
      <div class="mb-3 font-serif text-xl tracking-[.02em] text-white">NEUROCEBRYL</div>
      <p class="leading-relaxed">
        Catálogo informativo de suplementos alimenticios Geysson. No realizamos ventas ni pagos
        en línea.
      </p>
      <div class="mt-5 flex items-center gap-4">
        <a
          href={site.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook de Neurocebryl"
          class="text-rosa-grisaceo hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.242 0-1.63.775-1.63 1.57v1.887h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z"
            ></path>
          </svg>
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Neurocebryl"
          class="text-rosa-grisaceo hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2c-2.716 0-3.056.012-4.123.06-1.064.05-1.79.218-2.427.465a4.9 4.9 0 0 0-1.772 1.153A4.9 4.9 0 0 0 2.525 5.45c-.247.637-.416 1.363-.465 2.427C2.012 8.944 2 9.284 2 12s.012 3.056.06 4.123c.05 1.064.218 1.79.465 2.427a4.9 4.9 0 0 0 1.153 1.772 4.9 4.9 0 0 0 1.772 1.153c.637.247 1.363.416 2.427.465C8.944 21.988 9.284 22 12 22s3.056-.012 4.123-.06c1.064-.05 1.79-.218 2.427-.465a4.9 4.9 0 0 0 1.772-1.153 4.9 4.9 0 0 0 1.153-1.772c.247-.637.416-1.363.465-2.427.048-1.067.06-1.407.06-4.123s-.012-3.056-.06-4.123c-.05-1.064-.218-1.79-.465-2.427a4.9 4.9 0 0 0-1.153-1.772A4.9 4.9 0 0 0 18.55 2.525c-.637-.247-1.363-.416-2.427-.465C15.056 2.012 14.716 2 12 2Zm0 1.802c2.67 0 2.987.01 4.041.058.976.045 1.505.207 1.858.344.467.182.8.399 1.15.748.35.35.566.683.748 1.15.137.353.3.882.344 1.858.048 1.054.058 1.37.058 4.04 0 2.67-.01 2.987-.058 4.041-.045.976-.207 1.505-.344 1.858-.182.467-.399.8-.748 1.15-.35.35-.683.566-1.15.748-.353.137-.882.3-1.858.344-1.054.048-1.37.058-4.041.058-2.67 0-2.987-.01-4.04-.058-.976-.045-1.505-.207-1.858-.344a3.1 3.1 0 0 1-1.15-.748 3.1 3.1 0 0 1-.748-1.15c-.137-.353-.3-.882-.344-1.858-.048-1.054-.058-1.37-.058-4.041 0-2.67.01-2.987.058-4.04.045-.976.207-1.505.344-1.858.182-.467.399-.8.748-1.15.35-.35.683-.566 1.15-.748.353-.137.882-.3 1.858-.344 1.054-.048 1.37-.058 4.04-.058Zm0 3.063a5.135 5.135 0 1 0 0 10.27 5.135 5.135 0 0 0 0-10.27Zm0 8.468a3.333 3.333 0 1 1 0-6.666 3.333 3.333 0 0 1 0 6.666Zm5.338-8.671a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"
            ></path>
          </svg>
        </a>
        <a
          href={`mailto:${site.correoContacto}`}
          aria-label="Enviar correo a Neurocebryl"
          class="text-rosa-grisaceo hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5v-13Zm2.2.5 6.8 5.44L18.8 6H5.2ZM19.5 8.06l-6.94 5.55a1.5 1.5 0 0 1-1.87 0L4.5 8.06V18.5h15V8.06Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="flex flex-wrap gap-8">
      <a href="/catalogo" class="text-rosa-grisaceo hover:text-white">Catálogo</a>
      <a href="/empresa" class="text-rosa-grisaceo hover:text-white">Empresa</a>
      <a href="/contacto" class="text-rosa-grisaceo hover:text-white">Contacto</a>
      <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="text-rosa-grisaceo hover:text-white"
        >WhatsApp</a
      >
    </div>
  </div>
</footer>
