---
import { linkWhatsApp } from "../data/site";

const wa = linkWhatsApp("Hola, tengo una duda sobre los productos Neurocebryl.");
---

<a
  href={wa}
  target="_blank"
  rel="noopener"
  class="fixed right-6 bottom-6 z-[80] inline-flex items-center gap-2.5 rounded-full bg-verde-accion px-[22px] py-[15px] text-[14.5px] font-bold text-white shadow-[0_14px_30px_rgba(60,33,53,.32)] hover:bg-verde-accion-hover hover:text-white"
>
  <span class="h-[9px] w-[9px] rounded-full bg-white opacity-90"></span>¿Dudas? Escríbenos
</a>
