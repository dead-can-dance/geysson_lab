---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import TripackPromo from "../../components/TripackPromo.astro";
import { productos, precioTexto, relacionados } from "../../lib/productos";
import { linkWhatsApp } from "../../data/site";

export function getStaticPaths() {
  return productos.map((p) => ({
    params: { slug: p.slug },
    props: { producto: p },
  }));
}

const { producto } = Astro.props;
const wa = linkWhatsApp(
  `Hola, quiero información sobre ${producto.nombre} (${producto.presentacion}).`
);
const rel = relacionados(producto);
const metaDescripcion =
  producto.descripcion ||
  `${producto.nombre} — ${producto.presentacion}. Consulta disponibilidad por WhatsApp.`;
---

<BaseLayout title={producto.nombre} description={metaDescripcion}>
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-7 pt-[26px] font-mono text-[11.5px] text-lavanda-gris">
    <a href="/catalogo" class="font-mono text-[11.5px] text-morado-medio hover:text-morado-oscuro"
      >catálogo</a
    >
    <span>/</span><span class="text-morado-oscuro">{producto.nombre}</span>
  </div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-7 pt-7 pb-20 md:grid-cols-2 md:gap-[60px]">
    <div class="flex flex-col gap-3 md:sticky md:top-[92px] md:self-start">
      <div class="bg-fondo-imagen group relative aspect-square overflow-hidden rounded-2xl">
        <span
          class="absolute top-4 left-4 z-10 rounded-full bg-morado-principal px-[11px] py-[5px] font-mono text-[10.5px] tracking-[.1em] text-white uppercase"
        >
          {producto.categoria}
        </span>
        {
          producto.imagenFrente ? (
            <img
              src={producto.imagenFrente}
              alt={producto.nombre}
              class="absolute inset-0 h-full w-full object-contain"
            />
          ) : (
            <div class="bg-placeholder-frente absolute inset-0 flex items-end p-5">
              <span class="font-mono text-[11.5px] text-morado-medio">
                foto principal — {producto.nombre}
              </span>
            </div>
          )
        }
        {
          producto.imagenReverso ? (
            <img
              src={producto.imagenReverso}
              alt={`${producto.nombre} — modo de uso e ingredientes`}
              class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-200 group-hover:opacity-100"
            />
          ) : (
            <div class="bg-placeholder-trasera absolute inset-0 flex items-end p-5 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
              <span class="font-mono text-[11.5px] text-morado-principal">
                foto trasera — modo de uso e ingredientes
              </span>
            </div>
          )
        }
      </div>
      <p class="text-center font-mono text-[11px] text-lavanda-gris">
        pasa el cursor sobre la foto para ver el reverso
      </p>
    </div>

    <div>
      <div class="font-mono text-[11.5px] tracking-[.1em] text-lavanda-gris uppercase">
        {producto.categoria} · {producto.presentacion}
      </div>
      <h1 class="my-2.5 font-serif text-[44px] leading-[1.08] tracking-tight text-morado-oscuro">
        {producto.nombre}
      </h1>
      <div class="mb-[22px] text-[22px] font-bold text-morado-oscuro">{precioTexto(producto)}</div>
      {
        producto.descripcion && (
          <p class="mb-[30px] max-w-[520px] text-pretty text-base leading-relaxed text-morado-principal">
            {producto.descripcion}
          </p>
        )
      }

      <div class="border-t border-borde-suave py-6">
        <h3 class="mb-3.5 font-mono text-[11.5px] font-medium tracking-[.12em] text-lavanda-gris uppercase">
          Beneficios
        </h3>
        <div class="flex flex-col gap-2.5">
          {
            producto.beneficios.map((b) => (
              <div class="flex gap-2.5 text-[15px] leading-relaxed text-morado-oscuro">
                <span class="font-bold text-verde-accion">✓</span>
                {b}
              </div>
            ))
          }
        </div>
      </div>

      <div class="border-t border-borde-suave py-6">
        <h3 class="mb-3.5 font-mono text-[11.5px] font-medium tracking-[.12em] text-lavanda-gris uppercase">
          Presentación
        </h3>
        <div class="flex flex-wrap gap-2.5">
          <span class="rounded-full border border-patron-imagen px-[15px] py-2 text-[13px] text-morado-principal"
            >{producto.presentacion}</span
          >
          <span class="rounded-full border border-patron-imagen px-[15px] py-2 text-[13px] text-morado-principal"
            >{producto.categoria}</span
          >
        </div>
      </div>

      <div class="border-t border-borde-suave py-6">
        <h3 class="mb-3.5 font-mono text-[11.5px] font-medium tracking-[.12em] text-lavanda-gris uppercase">
          Advertencias
        </h3>
        <div class="rounded-[10px] border border-aviso-borde bg-aviso-fondo px-[18px] py-4 text-[13.5px] leading-relaxed text-aviso-texto">
          Este producto es un suplemento alimenticio, no un medicamento. Consulta a tu médico
          antes de consumirlo si estás embarazada, en periodo de lactancia o tomas otros
          medicamentos. Texto sujeto a validación final.
        </div>
      </div>

      <div class="mt-3.5 flex flex-wrap gap-3">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 rounded-full bg-verde-accion px-7 py-4 text-[15px] font-bold text-white hover:bg-verde-accion-hover hover:text-white"
        >
          <span class="h-2 w-2 rounded-full bg-white opacity-90"></span>Consultar por WhatsApp
        </a>
        <a
          href="/catalogo"
          class="rounded-full border border-morado-principal px-7 py-4 text-[14.5px] font-semibold text-morado-principal hover:bg-crema"
          >Volver al catálogo</a
        >
      </div>
    </div>
  </div>

  <TripackPromo producto={producto} />

  {
    rel.length > 0 && (
      <section class="mx-auto max-w-6xl px-7 pb-20">
        <span class="mb-2.5 block font-mono text-[11.5px] tracking-[.14em] text-lavanda-gris uppercase">
          También te puede interesar
        </span>
        <h2 class="m-0 mb-7 font-serif text-[34px] tracking-tight text-morado-oscuro">
          Productos relacionados
        </h2>
        <div class="grid grid-cols-2 gap-[22px] md:grid-cols-4">
          {rel.map((p) => <ProductCard producto={p} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
