---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { productos, masConsultadosSlugs, porCategoria } from "../lib/productos";
import { categorias } from "../data/site";
import { linkWhatsApp } from "../data/site";
import testimonios from "../data/testimonios.json";

const productoAncla = productos.find((p) => p.slug === "compuesto")!;
const waAncla = linkWhatsApp(
  `Hola, quiero información sobre ${productoAncla.nombre} (${productoAncla.presentacion}).`
);

const masConsultados = masConsultadosSlugs
  .map((id) => productos.find((p) => p.slug === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<BaseLayout
  title="Inicio"
  description="Catálogo digital de suplementos alimenticios Neurocebryl. Asesoría directa por WhatsApp."
>
  <!-- Hero -->
  <div class="bg-gradient-to-br from-morado-oscuro via-morado-principal to-morado-medio text-white">
    <div
      class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-7 pt-[88px] pb-24 md:grid-cols-[1.05fr_.95fr]"
    >
      <div>
        <div
          class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-white/35 px-[15px] py-2 font-mono text-[11.5px] tracking-[.12em] text-texto-header uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-rosa-grisaceo"></span>Fórmula original · Geysson
        </div>
        <h1
          class="m-0 text-pretty font-serif text-[42px] leading-[1.05] tracking-tight text-white md:text-[58px]"
        >
          Bienestar cognitivo,<br /><span class="font-light text-rosa-grisaceo italic"
            >respaldado por la fórmula</span
          ><br />que ya conoces.
        </h1>
        <p class="my-6 max-w-[470px] text-pretty text-[17px] leading-relaxed text-lavanda-clara">
          {productoAncla.nombre} es el producto ancla de nuestro catálogo: {
            productoAncla.presentacion.toLowerCase()
          } para tu energía mental y física diaria.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="/catalogo"
            class="rounded-full bg-white px-7 py-[15px] text-[15px] font-bold text-morado-oscuro hover:bg-hueso"
            >Ver catálogo completo</a
          >
          <a
            href={waAncla}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-white/45 px-7 py-[15px] text-[15px] font-semibold text-white hover:bg-white/10 hover:text-white"
            >Consultar por WhatsApp</a
          >
        </div>
      </div>
      <div class="relative flex justify-center">
        <div
          class="bg-placeholder-frente relative flex aspect-[4/3] w-full max-w-[400px] items-end justify-center rounded-2xl p-[18px] shadow-[0_30px_60px_rgba(0,0,0,.3)]"
        >
          <span class="text-center font-mono text-[11.5px] tracking-[.06em] text-morado-medio">
            foto de producto — sobre de ampolletas {productoAncla.nombre}
          </span>
        </div>
        <div
          class="absolute -top-3.5 -right-1.5 rounded-full bg-white px-4 py-[11px] text-center text-xs leading-tight font-bold text-morado-oscuro shadow-[0_10px_24px_rgba(0,0,0,.28)]"
        >
          Producto<br />ancla
        </div>
      </div>
    </div>
  </div>

  <!-- Franja de puntos -->
  <div class="border-b border-borde-suave bg-crema">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-7 px-7 py-[22px] text-[13.5px] text-morado-principal md:grid-cols-3">
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-lavanda-gris">01</span>Catálogo informativo, sin compras en línea
      </div>
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-lavanda-gris">02</span>Asesoría directa por WhatsApp
      </div>
      <div class="flex items-center gap-2.5">
        <span class="font-mono text-lavanda-gris">03</span>Suplementos alimenticios de fabricación Geysson
      </div>
    </div>
  </div>

  <!-- Más consultados -->
  <section class="mx-auto max-w-6xl px-7 pt-[76px] pb-5">
    <div class="mb-[34px] flex flex-wrap items-end justify-between gap-6">
      <div>
        <span class="mb-2.5 block font-mono text-[11.5px] tracking-[.14em] text-lavanda-gris uppercase">
          Consultas por WhatsApp · últimos 30 días
        </span>
        <h2 class="m-0 font-serif text-[38px] tracking-tight text-morado-oscuro">
          Los más consultados
        </h2>
      </div>
      <a
        href="/catalogo"
        class="border-b border-rosa-grisaceo pb-[3px] text-sm font-semibold text-morado-principal hover:border-morado-principal"
        >Ver todo el catálogo →</a
      >
    </div>
    <div class="grid grid-cols-2 gap-[22px] md:grid-cols-4">
      {masConsultados.map((p, i) => <ProductCard producto={p} rank={`0${i + 1}`} />)}
    </div>
  </section>

  <!-- Categorías -->
  <section class="mx-auto max-w-6xl px-7 py-[70px]">
    <span class="mb-2.5 block font-mono text-[11.5px] tracking-[.14em] text-lavanda-gris uppercase">
      Catálogo
    </span>
    <h2 class="m-0 mb-[30px] font-serif text-[38px] tracking-tight text-morado-oscuro">
      Explora por categoría
    </h2>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {categorias.map((c) => <CategoryCard nombre={c} conteo={porCategoria(c).length} />)}
    </div>
  </section>

  <!-- Testimonios -->
  <div class="border-t border-b border-borde-suave bg-crema">
    <section class="mx-auto max-w-6xl px-7 py-[70px]">
      <span class="mb-2.5 block font-mono text-[11.5px] tracking-[.14em] text-lavanda-gris uppercase">
        Testimonios seleccionados
      </span>
      <h2 class="m-0 mb-8 font-serif text-[38px] tracking-tight text-morado-oscuro">
        Lo que dicen quienes ya lo probaron
      </h2>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          testimonios.map((t) => (
            <TestimonialCard estrellas={t.estrellas} texto={t.texto} autor={t.autor} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
